{
  "nodes": [
    { "id": "met_0", "obj": "Metro", "hz": 8 },
    { "id": "cnt_0", "obj": "Count", "min": 0, "max": 3 },
    { "id": "if_0", "obj": "If", "if": 0, "return": 240 },
    { "id": "if_1", "obj": "If", "if": 1, "return": 440 },
    { "id": "if_2", "obj": "If", "if": 2, "return": 335 },
    { "id": "if_3", "obj": "If", "if": 3, "return": 660 },

    { "id": "osc_0", "obj": "Osc", "waveform": "sine", "freq":  660 },
    { "id": 7.12123, "obj": "Osc", "waveform": "sine", "freq":  660 },
    { "id": 8, "obj": "Osc", "waveform": "sine", "freq":  660 },
    { "id": 9, "obj": "Osc", "waveform": "sine", "freq":  660 },

    { "id": 10, "obj": "Env", "attack": 0, "decay": 100 },
    { "id": 11, "obj": "Env", "attack": 100, "decay": 0 },
    { "id": 12, "obj": "Env", "attack": 200, "decay": 200 },
    { "id": 13, "obj": "Env", "attack": 400, "decay": 0 },

    { "id": 14, "obj": "AudioOut" }
  ],
  "connections": [
    // metro -> count
    { "sourceNode": "met_0", "sourcePort": 0, "targetNode": 1, "targetPort": 0 },

    // count -> if
    { "sourceNode": "cnt_0", "sourcePort": 0, "targetNode": "if_0", "targetPort": 0 },
    { "sourceNode": "cnt_0", "sourcePort": 0, "targetNode": "if_1", "targetPort": 0 },
    { "sourceNode": "cnt_0", "sourcePort": 0, "targetNode": "if_2", "targetPort": 0 },
    { "sourceNode": "cnt_0", "sourcePort": 0, "targetNode": "if_3", "targetPort": 0 },

    // if -> oscillators freq
    { "sourceNode": 2, "sourcePort": 0, "targetNode": "osc_0", "targetPort": 1 },
    { "sourceNode": 3, "sourcePort": 0, "targetNode": 7.12123, "targetPort": 1 },
    { "sourceNode": 4, "sourcePort": 0, "targetNode": 8, "targetPort": 1 },
    { "sourceNode": 5, "sourcePort": 0, "targetNode": 9, "targetPort": 1 },

    // if -> oscillators phase reset
    { "sourceNode": 2, "sourcePort": 0, "targetNode": 6, "targetPort": 0 },
    { "sourceNode": 3, "sourcePort": 0, "targetNode": 7.12123, "targetPort": 0 },
    { "sourceNode": 4, "sourcePort": 0, "targetNode": 8, "targetPort": 0 },
    { "sourceNode": 5, "sourcePort": 0, "targetNode": 9, "targetPort": 0 },

    // oscillator -> envelope
    { "sourceNode": "osc_0", "sourcePort": 0, "targetNode": 10, "targetPort": 1 },
    { "sourceNode": 7.12123, "sourcePort": 0, "targetNode": 11, "targetPort": 1 },
    { "sourceNode": 8, "sourcePort": 0, "targetNode": 12, "targetPort": 1 },
    { "sourceNode": 9, "sourcePort": 0, "targetNode": 13, "targetPort": 1 },

    // if's -> envelopes
    { "sourceNode": 2, "sourcePort": 0, "targetNode": 10, "targetPort": 0 },
    { "sourceNode": 3, "sourcePort": 0, "targetNode": 11, "targetPort": 0 },
    { "sourceNode": 4, "sourcePort": 0, "targetNode": 12, "targetPort": 0 },
    { "sourceNode": 5, "sourcePort": 0, "targetNode": 13, "targetPort": 0 },

    // envelopes -> output
    //{ "sourceNode": 10, "sourcePort": 0, "targetNode": 14, "targetPort": 0 },
    //{ "sourceNode": 11, "sourcePort": 0, "targetNode": 14, "targetPort": 0 },
    //{ "sourceNode": 12, "sourcePort": 0, "targetNode": 14, "targetPort": 0 },
    { "sourceNode": 13, "sourcePort": 0, "targetNode": 14, "targetPort": 0 }
  ]
}