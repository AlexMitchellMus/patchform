{
    "nodes": [
        { "id": 0, "obj": "Value", "value": 770.0 },
        { "id": 1, "obj": "Oscillator", "waveform": "sine" },
        { "id": 2, "obj": "Metro", "hz": 8 },
        { "id": 3, "obj": "Envelope", "attack": 0, "decay": 200 },

        { "id": 4, "obj": "Value", "value": 200.0 },
        { "id": 5, "obj": "Oscillator", "waveform": "tri" },
        { "id": 6, "obj": "Envelope", "attack": 0, "decay": 10 },

        { "id": 7, "obj": "AudioOut" }
    ],
    "connections": [
        // value -> oscillator
        { "sourceNode": 0, "sourcePort": 0, "targetNode": 1, "targetPort": 0 },
        { "sourceNode": 4, "sourcePort": 0, "targetNode": 5, "targetPort": 0 },

        // oscillator -> envelope
        { "sourceNode": 1, "sourcePort": 0, "targetNode": 3, "targetPort": 1 },
        { "sourceNode": 5, "sourcePort": 0, "targetNode": 6, "targetPort": 1 },

        // metro -> envelope
        { "sourceNode": 2, "sourcePort": 0, "targetNode": 3, "targetPort": 0 },
        { "sourceNode": 2, "sourcePort": 0, "targetNode": 6, "targetPort": 0 },

        // metro -> oscillator (phase reset)
        { "sourceNode": 2, "sourcePort": 0, "targetNode": 1, "targetPort": 0 },
        { "sourceNode": 2, "sourcePort": 0, "targetNode": 5, "targetPort": 0 },

        // envelope -> audio out
        { "sourceNode": 3, "sourcePort": 0, "targetNode": 7, "targetPort": 0 },
        { "sourceNode": 6, "sourcePort": 0, "targetNode": 7, "targetPort": 0 }
    ]
}